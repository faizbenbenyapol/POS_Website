# ==============================================================================
# Database Configuration (MySQL)
# ==============================================================================
# ใช้สำหรับระบุการเชื่อมต่อฐานข้อมูล MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pos_qr

# Optional: Connection String เต็มรูปแบบ (หากระบุ ค่านี้จะถูกใช้เป็นลำดับแรก)
# DATABASE_URL=mysql://root@localhost:3306/pos_qr

# ขนาดสูงสุดของ Connection Pool เพื่อรองรับ Concurrent Queries
DB_CONNECTION_LIMIT=20

# ==============================================================================
# Security & Authentication
# ==============================================================================
# คีย์ลับสำหรับเซ็นและตรวจสอบสิทธิ์ JSON Web Token (อย่างน้อย 32 ตัวอักษร)
# บังคับต้องสร้างใหม่ด้วยคำสั่ง: openssl rand -hex 32
JWT_SECRET=replace_with_your_generated_secret_32_bytes

# ==============================================================================
# Application URL Configuration
# ==============================================================================
# ที่อยู่หลักของแอปพลิเคชัน สำหรับสร้าง QR Code สแกนสั่งอาหารและเรียกดูหน้าเว็บ
NEXT_PUBLIC_BASE_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# ==============================================================================
# Business Operations Configuration
# ==============================================================================
# เวลาตัดรอบวันทำการของร้านอาหาร (0-23 นาฬิกา, ค่าเริ่มต้นคือ 4 หรือ 04:00 น.)
BUSINESS_DAY_CUTOFF_HOUR=4


# ==============================================================================
# Payments (รับเงินโอนผ่าน QR พร้อมเพย์ — ดู plan.md หัวข้อ 23.3)
# ==============================================================================
# ผู้ให้บริการรับเงิน: promptpay = เข้าบัญชีร้านตรง แคชเชียร์ยืนยันเอง / mock = ผู้ให้บริการจำลองสำหรับทดสอบ
# ไม่ตั้งค่า: เครื่องพัฒนาใช้ mock ส่วน production ใช้ promptpay
# PAYMENT_PROVIDER=promptpay

# secret สำหรับตรวจลายเซ็น webhook ของผู้ให้บริการ ไม่ตั้ง = ไม่รับ webhook เลย
# สร้างด้วยคำสั่ง: openssl rand -hex 32
# PAYMENT_WEBHOOK_SECRET=

# เปิดปุ่ม "จำลองว่าลูกค้าโอนแล้ว" บน production (ใช้กับเครื่องทดสอบเท่านั้น ห้ามเปิดบนร้านจริง)
# PAYMENT_ALLOW_SIMULATE=0
